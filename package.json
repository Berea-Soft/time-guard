{
  "name": "@bereasoftware/time-guard",
  "private": false,
  "version": "2.7.2",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/time-guard.cjs",
  "module": "./dist/time-guard.es.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/time-guard.umd.js",
  "browser": {
    "./dist/time-guard.umd.js": "./dist/time-guard.umd.js",
    "./dist/time-guard.iife.js": "./dist/time-guard.iife.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/time-guard.es.js",
      "require": "./dist/time-guard.cjs",
      "default": "./dist/time-guard.es.js"
    },
    "./native": {
      "types": "./dist/types/native.d.ts",
      "import": "./dist/native/index.es.js",
      "require": "./dist/native/index.cjs",
      "default": "./dist/native/index.es.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react/index.es.js",
      "require": "./dist/react/index.cjs",
      "default": "./dist/react/index.es.js"
    },
    "./vue": {
      "types": "./dist/types/vue.d.ts",
      "import": "./dist/vue/index.es.js",
      "require": "./dist/vue/index.cjs",
      "default": "./dist/vue/index.es.js"
    },
    "./angular": {
      "types": "./dist/types/angular.d.ts",
      "import": "./dist/angular/index.es.js",
      "require": "./dist/angular/index.cjs",
      "default": "./dist/angular/index.es.js"
    },
    "./svelte": {
      "types": "./dist/types/svelte.d.ts",
      "import": "./dist/svelte/index.es.js",
      "require": "./dist/svelte/index.cjs",
      "default": "./dist/svelte/index.es.js"
    },
    "./solid": {
      "types": "./dist/types/solid.d.ts",
      "import": "./dist/solid/index.es.js",
      "require": "./dist/solid/index.cjs",
      "default": "./dist/solid/index.es.js"
    },
    "./qwik": {
      "types": "./dist/types/qwik.d.ts",
      "import": "./dist/qwik/index.es.js",
      "require": "./dist/qwik/index.cjs",
      "default": "./dist/qwik/index.es.js"
    },
    "./locales": {
      "types": "./dist/types/locales/index.d.ts",
      "import": "./dist/locales/index.es.js",
      "require": "./dist/locales/index.cjs",
      "default": "./dist/locales/index.es.js"
    },
    "./calendars": {
      "types": "./dist/types/calendars/index.d.ts",
      "import": "./dist/calendars/index.es.js",
      "require": "./dist/calendars/index.cjs",
      "default": "./dist/calendars/index.es.js"
    },
    "./plugins/relative-time": {
      "types": "./dist/types/plugins/relative-time.d.ts",
      "import": "./dist/plugins/relative-time.es.js",
      "require": "./dist/plugins/relative-time.cjs",
      "default": "./dist/plugins/relative-time.es.js"
    },
    "./plugins/duration": {
      "types": "./dist/types/plugins/duration.d.ts",
      "import": "./dist/plugins/duration.es.js",
      "require": "./dist/plugins/duration.cjs",
      "default": "./dist/plugins/duration.es.js"
    },
    "./plugins/advanced-format": {
      "types": "./dist/types/plugins/advanced-format.d.ts",
      "import": "./dist/plugins/advanced-format.es.js",
      "require": "./dist/plugins/advanced-format.cjs",
      "default": "./dist/plugins/advanced-format.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "packageManager": "pnpm@11.0.9",
  "keywords": [
    "time-guard",
    "typescript",
    "date",
    "time",
    "temporal",
    "date-time",
    "datetime",
    "immutable",
    "locale",
    "i18n",
    "internationalization",
    "formatter",
    "date-formatter",
    "temporal-api",
    "solid-principles",
    "javascript"
  ],
  "author": "John Andrade <johnandrade@bereasoft.com>",
  "license": "MIT",
  "description": "A modern, fully-typed TypeScript date/time library built with the Temporal API, SOLID principles, and complete i18n support. Immutable, zero-dependencies, and designed for type safety.",
  "maintainers": [
    {
      "name": "John Andrade",
      "email": "johnandrade@bereasoft.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Berea-Soft/time-guard"
  },
  "bugs": {
    "url": "https://github.com/Berea-Soft/time-guard/issues"
  },
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10.8.2"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not IE 11",
    "> 1%"
  ],
  "homepage": "https://github.com/Berea-Soft/time-guard#readme",
  "scripts": {
    "dev:docs": "pnpm --prefix docs-app install && pnpm --prefix docs-app dev",
    "build:docs": "pnpm --prefix docs-app build",
    "typecheck:docs": "pnpm --prefix docs-app typecheck",
    "format:docs": "prettier --write \"docs-app/src/**/*.{ts,js,vue,css,json}\" \"docs-app/*.{json,js}\"",
    "format:docs:check": "prettier --check \"docs-app/src/**/*.{ts,js,vue,css,json}\" \"docs-app/*.{json,js}\"",
    "lint:docs": "pnpm --prefix docs-app lint",
    "lint:docs:fix": "pnpm --prefix docs-app lint:fix",
    "build": "vite build && vite build --mode umd && vite build --mode angular",
    "build:all": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "peerDependencies": {
    "@angular/core": ">=21.2.14",
    "react": ">=19.2.6",
    "rxjs": ">=7.8.2",
    "vue": ">=3.5.34",
    "svelte": ">=5.55.9",
    "solid-js": ">=1.9.13",
    "@builder.io/qwik": ">=1.20.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@builder.io/qwik": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^21.2.14",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "rxjs": "^7.8.2",
    "semantic-release": "^25.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7",
    "vue": "^3.5.34"
  }
}
