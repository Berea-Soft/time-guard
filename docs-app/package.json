{
  "name": "time-guard-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --config ./eslint.config.js --max-warnings=0",
    "lint:fix": "eslint src --config ./eslint.config.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js,vue,css,json}\" \"*.{json,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,vue,css,json}\" \"*.{json,js}\""
  },
  "packageManager": "pnpm@11.0.9",
  "dependencies": {
    "@bereasoftware/time-guard": "^2.6.0",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.11.0",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.6.0",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.0",
    "@codesandbox/sandpack-client": "2.19.8",
    "@codesandbox/sandpack-themes": "^2.0.21",
    "@lezer/highlight": "1.2.3",
    "@lucide/vue": "^1.16.0",
    "codemirror": "6.0.2",
    "lz-string": "^1.5.0",
    "sandpack-vue3": "^3.1.12",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3.3.1",
    "prettier": "^3.8.2",
    "eslint": "^8.46.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint-plugin-vue": "^9.18.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
